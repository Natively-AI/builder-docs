          "href": "/changelog"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "/support"
        }
      ]
    },
    "groups": [
      {
        "group": "Introduction",
        "icon": "sparkles",
        "pages": [
