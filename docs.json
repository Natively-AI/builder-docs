          "introduction/welcome",
          "introduction/getting-started",
          "introduction/plans-and-credits",
          "introduction/faq"
        ]
      },
      {
        "group": "Features",
        "icon": "layers",
        "pages": [
          "features/publish",
          "features/custom-domain",
          "features/workspaces",
          "features/integrations",
          "features/supabase",
          "features/github-sync",
          "features/files-and-download",
